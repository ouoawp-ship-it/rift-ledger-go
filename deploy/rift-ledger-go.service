[Unit]
Description=Rift Ledger Go server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=rift-ledger-go
StateDirectoryMode=0700
WorkingDirectory=/var/lib/rift-ledger-go
EnvironmentFile=/etc/rift-ledger-go.env
Environment=DATA_DIR=/var/lib/rift-ledger-go
Environment=LISTEN_ADDR=127.0.0.1:8080
ExecStart=/usr/local/bin/rift-ledger-go
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
